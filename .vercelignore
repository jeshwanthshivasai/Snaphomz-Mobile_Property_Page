# ==========================================
# .vercelignore
# Exclude non-production & heavy assets from Vercel deployments
# ==========================================

# Design mocks, reference screenshots, and prototype files (~46 MB)
snaphomz-mobile-app-view/
*.sketch
*.fig
*.psd
*.ai
*.xd

# Raw 3D files & unbundled CAD assets
*.glb
*.gltf
*.obj
*.fbx
*.blend
*.dae

# Heavy uncompressed video / audio media
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.wav
*.mp3
*.flac

# Local mock data, fixtures, and scratch files
mocks/
mock/
fixtures/
scratch/
test-data/
*.mock.json

# Test suites & coverage reports
test/
tests/
__tests__/
cypress/
playwright/
coverage/
*.test.*
*.spec.*

# Documentation, blueprints, and markdown notes
docs/
doc/
*.md
!README.md

# Development & IDE configurations
.github/
.husky/
.vscode/
.idea/
.editorconfig
.prettierrc*
.prettierignore
.eslintrc*
.oxlintrc*

# Operating system & temporary files
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Local environment files (credentials should be set in Vercel Project Settings)
.env*.local
.env
